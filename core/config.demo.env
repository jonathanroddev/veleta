# config.demo.env — configuration for the BUNDLED DEMO RECORDING
# ---------------------------------------------------------------------
# Use it with:
#     python3 -m veleta_core --config config.demo.env \
#             --play samples/wt901_desk_wobble.jsonl --loop
#
# WHY THIS FILE EXISTS
# The demo replays a recording of a WT901WIFI stream: 13 fields with a
# DeviceID at index 0. That is the WiFi layout, which is also what the
# built-in DEFAULTS carry — so for a long time the demo ran with no
# --config at all and worked by coincidence.
#
# It stopped being a safe coincidence when the wired package shipped
# without config.env in it: the demo there had nothing to read and fell
# back to those defaults silently. Changing DEFAULTS, or re-recording the
# sample from a different sensor, would have broken the one thing a buyer
# runs before their hardware works, with no error and no clue.
#
# So the demo names its layout, like every other path does. This file is
# the layout of the recordings in samples/, and tests/test_playback.py
# replays every one of them through it: a sample whose layout drifts from
# this file fails the suite instead of the demo.
#
# It ships in BOTH Windows packages, because both carry the demo.
# Everything not listed here keeps the same meaning as in config.env.

# --- Where the sensor frames come from ---
# The demo is always a recording. --play sets this anyway; it is written
# here so the file describes a complete, runnable configuration.
SOURCE=file

# --- Output: the socket consumers talk to ---
# Unchanged from config.env: the demo drives Blender exactly as a live
# sensor would, so a consumer finds it in the usual place.
CONTROL_HOST=127.0.0.1
CONTROL_PORT=1400
SUBSCRIPTION_TTL=10

# --- Frame profile ---
# The recordings are `fused` (the sensor did the fusion). `auto` reads that
# from the field count, and keeps this file honest if a raw6 recording is
# ever added to samples/.
FRAME_FORMAT=auto

# --- Protocol / parsing (CSV field indices, 0-based) ---
# The WT901WIFI layout the recordings hold:
#   fused (13 fields): 0=DeviceID 1..3=Acc 4..6=Gyro 7..9=Angle 10..12=Mag
IDX_DEVICE=0
IDX_ACC_X=1
IDX_ACC_Y=2
IDX_ACC_Z=3
IDX_GYRO_X=4
IDX_GYRO_Y=5
IDX_GYRO_Z=6
IDX_ANGLE_X=7
IDX_ANGLE_Y=8
IDX_ANGLE_Z=9
MIN_FIELDS=7

# --- Fusion, for raw6 recordings only (ignored by fused ones) ---
ALPHA_ROLL_PITCH=0.98
GYRO_CALIB_SAMPLES=50

# --- Reference pose calibration ---
# On a recording there is nobody to strike a pose, so the countdown only
# decides which frame becomes "zero". Left as it is elsewhere: the demo
# should behave like the real thing, not like a special case.
AUTO_CALIBRATE=1
CALIB_COUNTDOWN=3
