# config.wired.env — configuration for the WIRED BENCH
# ---------------------------------------------------------------------
# Use it with:   python3 -m veleta_core --config config.wired.env
#
# WHY THIS FILE EXISTS
# The wired bench and the WiFi sensors do not share a CSV layout, so they
# cannot share one set of IDX_*:
#
#   WiFi  (raw6, 7 fields):  0=DeviceID 1..3=Acc 4..6=Gyro
#   Wired (6 fields, no id):           0..2=Acc 3..5=Gyro
#
# A cable carries exactly one sensor, so the wired frames carry no
# DeviceID (docs/protocol.md, "The wired bench is the exception") and every
# index shifts down by one. Point the default config.env at a wired board
# and every line is rejected as UNPARSED — the indices, not the parser, are
# what is wrong. This file is that configuration, not a second parser.
#
# Everything not listed here keeps the same meaning as in config.env.
#
# NOTE: BLE frames use this SAME 6-field layout (one connection is one
# sensor, so there is no DeviceID either). To run a BLE sensor, take this
# file and set SOURCE=ble.
# --- Where the sensor frames come from ---
# udp    -> WiFi sensors (the sellable kit)
# serial -> the wired bench (needs pyserial)
# file   -> replay a .jsonl recording (see --play)
SOURCE=serial

# --- UDP input (SOURCE=udp) ---
# IP this machine listens on. 0.0.0.0 = all interfaces (recommended).
LISTEN_HOST=0.0.0.0
# Port the sensor(s) send to. It must match what every sensor is
# configured with: the "user server port" in WitMotion's tool, and
# DEST_PORT in each board's firmware/*/secrets.h.
LISTEN_PORT=1399

# --- Serial input (SOURCE=serial) ---
# macOS:   ls /dev/cu.*     (/dev/cu.wchusbserial* for CH340 clones)
# Linux:   ls /dev/ttyUSB*
# Windows: Device Manager   (e.g. COM3)
# Placeholder on purpose: it differs per machine. The bench Nano used on
# 2026-08-24 is an original one (FT232R, not a CH340 clone) and enumerates
# as /dev/cu.usbserial-XXXXXXXX.
SERIAL_PORT=/dev/cu.usbserial-CHANGE_ME
BAUD_RATE=115200
# A cable carries exactly one sensor, so wired frames have no DeviceID.
# This is the name that sensor gets in the output stream.
SERIAL_DEVICE_ID=wired

# --- Output: the socket consumers talk to ---
# Consumers (the Blender extension, tools, a future Godot adapter) send
# their commands here and get the pose stream back on the same socket.
# 127.0.0.1 keeps the core off the network: change it only if a consumer
# runs on a different machine.
CONTROL_HOST=127.0.0.1
CONTROL_PORT=1400
# Seconds a subscriber keeps receiving poses without renewing. A consumer
# that crashes stops being sent to after this long.
SUBSCRIPTION_TTL=10

# --- Frame profile ---
# auto  -> decide per frame from its field count (prefers `fused`)
# fused -> force "the sensor already gives me angles" (WT901WIFI)
# raw6  -> force "the sensor gives me accel+gyro, fuse it here"
FRAME_FORMAT=raw6

# --- Protocol / parsing (CSV field indices, 0-based) ---
# The exact layout may vary with the firmware. VERIFY first with
# tools/read_udp.py and adjust these indices — never the parser code.
#   raw6  (7 fields):  0=DeviceID 1..3=Acc 4..6=Gyro
#   fused (13 fields): 0=DeviceID 1..3=Acc 4..6=Gyro 7..9=Angle 10..12=Mag
IDX_DEVICE=0
IDX_ACC_X=0
IDX_ACC_Y=1
IDX_ACC_Z=2
IDX_GYRO_X=3
IDX_GYRO_Y=4
IDX_GYRO_Z=5
# Unused on the bench: a raw6 sensor sends no angles. Kept above the
# 6-field raw6 requirement so `auto` could never mistake a wired frame
# for a fused one.
IDX_ANGLE_X=7
IDX_ANGLE_Y=8
IDX_ANGLE_Z=9
# Minimum fields for a frame to be considered at all (junk filter). The
# per-profile requirement is derived from the indices above.
MIN_FIELDS=6

# --- Fusion, for raw6 sensors only (ignored by fused ones) ---
# Gyro weight in roll/pitch (0..1). Higher = smoother but slower to
# correct; lower = more reactive to the accelerometer (more jittery).
ALPHA_ROLL_PITCH=0.98
# Frames at rest used to estimate each device's gyro bias at startup.
# KEEP THE SENSOR STILL while this runs, or the bias integrates as drift.
GYRO_CALIB_SAMPLES=50

# --- Reference pose calibration ---
# If 1, on startup it waits CALIB_COUNTDOWN seconds and captures each
# sensor's orientation as "zero". Afterwards the inverse is applied to
# every reading. Consumers can re-trigger it at any time with the
# `calibrate` command.
AUTO_CALIBRATE=1
# With raw6 sensors give it room: they spend GYRO_CALIB_SAMPLES frames
# estimating the gyro bias first (50 frames at 20 Hz = 2.5 s).
CALIB_COUNTDOWN=3
